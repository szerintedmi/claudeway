{
  "name": "claudeway",
  "version": "0.12.0",
  "description": "Slack-to-Claude Code CLI gateway for solo developers",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "test:coverage": "bun test --coverage src/",
    "sync-repos": "bun -e \"import { syncRepos } from './src/sync-repos.ts'; syncRepos();\"",
    "prepare": "husky"
  },
  "keywords": [
    "slack",
    "claude",
    "claude-code",
    "gateway",
    "cli"
  ],
  "author": "Tamas Kalman",
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "^5.5.0",
    "@slack/bolt": "4.7.3",
    "uuid": "14.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
