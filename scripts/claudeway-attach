#!/bin/bash
# claudeway-attach — Stage a file for delivery back through the channel
# Called by Claude CLI via its Bash tool.
#
# The session temp dir is in $CLAUDEWAY_TEMP_DIR (set once per spawn, fixed for
# the whole session in persistent mode). The staged paths are drained and
# uploaded at the end of the turn, then the manifest is cleared (the files
# themselves persist for the rest of the conversation).
#
# Usage: claudeway-attach <file_path>
#   file_path: Path to an existing file to attach to the response.

set -eu

SESSION_DIR="${CLAUDEWAY_TEMP_DIR:-}"

if [ -z "$SESSION_DIR" ]; then
  echo "Error: No temp directory available. File attachment is not available in this context." >&2
  exit 1
fi

if [ -z "${1:-}" ]; then
  echo "Usage: claudeway-attach <file_path>" >&2
  exit 1
fi

# Resolve to absolute path
FILE="$(realpath "$1" 2>/dev/null || echo "$1")"

if [ ! -f "$FILE" ]; then
  echo "Error: File not found: $FILE" >&2
  exit 1
fi

if [ ! -d "$SESSION_DIR" ]; then
  echo "Error: Temp directory no longer exists: $SESSION_DIR" >&2
  exit 1
fi

printf '%s\n' "$FILE" >> "$SESSION_DIR/.attachments"
echo "Staged for attachment: $(basename "$FILE")"
