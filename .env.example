SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
CLAUDE_CODE_OAUTH_TOKEN=<run claude setup-token to generate>
GLASSES_AUTH_TOKEN=<secret token, eg. generate with: openssl rand -base64 32>
DEEPGRAM_API_KEY=<your Deepgram API key from console.deepgram.com>
# Private SSH key for cloning repos via SSH in Docker (default: ~/.ssh/id_ed25519)
GIT_SSH_KEY=~/.ssh/id_ed25519
