SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Master key for the per-user credential store (required at startup).
# Users connect their own Claude tokens via !creds — there is no server-wide Claude token.
CLAUDEWAY_SECRETS_KEY=<run openssl rand -hex 32 to generate>
GLASSES_AUTH_TOKEN=<secret token, eg. generate with: openssl rand -base64 32>
DEEPGRAM_API_KEY=<your Deepgram API key from console.deepgram.com>
# Shared credential defaults. These are exposed only through userCredentials
# mappings in config.yaml; enrolled user credentials override them.
SHARED_JIRA_USERNAME=service-account@example.com
SHARED_JIRA_API_TOKEN=atlassian-token
SHARED_GITHUB_TOKEN=github-fine-grained-pat
SHARED_NEWRELIC_API_KEY=NRAK-your-user-key
SHARED_LANGFUSE_SECRET_KEY=sk-lf-...
SHARED_LANGFUSE_PUBLIC_KEY=pk-lf-...
SHARED_LANGFUSE_HOST=https://cloud.langfuse.com
# Private SSH key for cloning repos via SSH in Docker (default: ~/.ssh/id_ed25519)
GIT_SSH_KEY=~/.ssh/id_ed25519
